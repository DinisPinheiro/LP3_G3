<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.GestaoServicosViewController"
      spacing="14">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="8" prefWidth="380" minWidth="300" HBox.hgrow="ALWAYS">
        <Label fx:id="labelTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <ListView fx:id="listaServicos" VBox.vgrow="ALWAYS"/>
        <Label fx:id="labelMensagem" wrapText="true"/>
        <Button text="Voltar ao menu" onAction="#onVoltar"/>
    </VBox>

    <VBox fx:id="painelFormulario" spacing="10" prefWidth="360" minWidth="320">
        <Label fx:id="labelModo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="95"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Tipo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="campoTipo" promptText="Serviço ou extra" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Nome *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="campoNome" maxWidth="Infinity"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Categoria" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="campoCategoria" promptText="ex.: Spa, Bebidas" maxWidth="Infinity"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Descrição" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="campoDescricao" maxWidth="Infinity"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Preço (€) *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="campoPreco" promptText="ex.: 8,50" maxWidth="Infinity"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Estado" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <CheckBox fx:id="campoAtivo" text="Ativo (disponível)"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="8">
            <Button text="Novo" onAction="#onNovo"/>
            <Button text="Guardar" defaultButton="true" onAction="#onGuardar"/>
        </HBox>
    </VBox>
</HBox>
