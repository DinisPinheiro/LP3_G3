<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ImportacaoFornecedorViewController"
      spacing="8">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Enviar entrega (XML)" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="labelFornecedor" wrapText="true" style="-fx-text-fill: #555555;"/>

    <HBox spacing="8">
        <Button fx:id="botaoEscolher" text="Escolher ficheiro XML..." defaultButton="true" onAction="#onEscolherFicheiro"/>
        <Label fx:id="labelFicheiro" text="Nenhum ficheiro escolhido." style="-fx-text-fill: #555555;"/>
    </HBox>

    <Label fx:id="labelMensagem" wrapText="true"/>
    <Label fx:id="labelCabecalho" wrapText="true" style="-fx-font-weight: bold;"/>
    <Label fx:id="labelTotais" wrapText="true"/>

    <TableView fx:id="tabelaLinhas" VBox.vgrow="ALWAYS" prefHeight="140">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaNumero" text="Linha" minWidth="45"/>
            <TableColumn fx:id="colunaCodigo" text="Código" minWidth="80"/>
            <TableColumn fx:id="colunaDescricao" text="Artigo" minWidth="220"/>
            <TableColumn fx:id="colunaQuantidade" text="Quantidade" minWidth="90"/>
            <TableColumn fx:id="colunaCaixas" text="Caixas" minWidth="55"/>
            <TableColumn fx:id="colunaUnidades" text="Unidades" minWidth="65"/>
            <TableColumn fx:id="colunaPreco" text="Preço unitário" minWidth="100"/>
            <TableColumn fx:id="colunaTaxa" text="Taxa" minWidth="50"/>
            <TableColumn fx:id="colunaSemTaxa" text="Sem taxa" minWidth="80"/>
            <TableColumn fx:id="colunaValorTaxa" text="Valor da taxa" minWidth="80"/>
            <TableColumn fx:id="colunaTotalLinha" text="Total da linha" minWidth="90"/>
        </columns>
    </TableView>

    <TextArea fx:id="areaErros" editable="false" wrapText="true" prefRowCount="5" visible="false" managed="false"/>

    <CheckBox fx:id="checkAtualizarFicha" text="Atualizar a minha ficha (nome, morada, código postal e cidade) com os dados do XML"/>
    <HBox spacing="8">
        <Button fx:id="botaoEnviar" text="Enviar ao hotel" disable="true" onAction="#onEnviar"/>
    </HBox>

    <Label text="Os meus ficheiros enviados" style="-fx-font-weight: bold;"/>
    <TableView fx:id="tabelaImportacoes" VBox.vgrow="ALWAYS" prefHeight="140">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaFicheiro" text="Ficheiro" minWidth="160"/>
            <TableColumn fx:id="colunaEncomenda" text="Encomenda" minWidth="90"/>
            <TableColumn fx:id="colunaEnviadoEm" text="Enviado em" minWidth="110"/>
            <TableColumn fx:id="colunaEstado" text="Estado" minWidth="80"/>
        </columns>
    </TableView>
</VBox>
