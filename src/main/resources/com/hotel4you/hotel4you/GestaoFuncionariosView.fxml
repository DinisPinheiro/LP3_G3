<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.GestaoFuncionariosViewController"
      spacing="10">

    <padding>
        <Insets top="18"
                right="18"
                bottom="18"
                left="18"/>
    </padding>

    <Label text="Gestão de funcionários"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="8">

        <TextField fx:id="campoNome"
                   promptText="Nome completo"
                   HBox.hgrow="ALWAYS"/>

        <TextField fx:id="campoUsername"
                   promptText="Nome de utilizador"
                   HBox.hgrow="ALWAYS"/>

    </HBox>

    <HBox spacing="8">

        <PasswordField fx:id="campoPassword"
                       promptText="Palavra-chave"
                       HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="campoPerfil"
                  promptText="Escolha o perfil"
                  prefWidth="220"/>

        <Button text="Criar funcionário"
                onAction="#onCriar"/>

    </HBox>

    <Label text="Utilizadores existentes:"/>

    <ListView fx:id="listaUtilizadores"
              VBox.vgrow="ALWAYS"
              prefHeight="230"/>

    <HBox spacing="8">

        <Button text="Desativar selecionado"
                onAction="#onDesativar"/>

        <Button text="Voltar ao menu"
                onAction="#onVoltar"/>

    </HBox>

    <Label fx:id="labelMensagem"
           wrapText="true"
           style="-fx-text-fill: #b03a2e;"/>

</VBox>