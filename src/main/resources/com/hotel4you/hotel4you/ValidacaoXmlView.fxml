<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ValidacaoXmlViewController"
      spacing="8">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Entrada de stock: XML do fornecedor" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="8">
        <Button text="Escolher ficheiro XML..." defaultButton="true" onAction="#onEscolherFicheiro"/>
        <Label fx:id="labelFicheiro" text="Nenhum ficheiro escolhido." style="-fx-text-fill: #555555;"/>
    </HBox>

    <Label fx:id="labelMensagem" wrapText="true"/>
    <Label fx:id="labelCabecalho" wrapText="true" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tabelaLinhas" VBox.vgrow="ALWAYS" prefHeight="180">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaNumero" text="Linha" minWidth="45"/>
            <TableColumn fx:id="colunaCodigo" text="Código" minWidth="80"/>
            <TableColumn fx:id="colunaDescricao" text="Artigo" minWidth="220"/>
            <TableColumn fx:id="colunaQuantidade" text="Quantidade" minWidth="90"/>
        </columns>
    </TableView>

    <TextArea fx:id="areaErros" editable="false" wrapText="true" prefRowCount="5" visible="false" managed="false"/>

    <HBox spacing="8">
        <Button fx:id="botaoEntrada" text="Dar entrada em stock" disable="true" onAction="#onDarEntrada"/>
        <Button text="Voltar ao stock" onAction="#onVoltar"/>
    </HBox>
</VBox>
