<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- S7-02: janela de configuração das unidades dos produtos (unidade principal e conversão de caixas). -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.UnidadesProdutosViewController"
      spacing="10" prefWidth="640" prefHeight="460">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Unidades dos produtos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="O stock, os quartos e as reservas contam na unidade principal. Indique quantas unidades tem uma caixa (ex.: 1 caixa = 10 unidades). Um produto antigo ainda em caixas passa a contar unidades."
           wrapText="true" style="-fx-text-fill: #555555;"/>

    <TableView fx:id="tabelaProdutos" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaProduto" text="Produto" minWidth="220"/>
            <TableColumn fx:id="colunaUnidade" text="Unidade principal" minWidth="110"/>
            <TableColumn fx:id="colunaConversao" text="Conversão" minWidth="110"/>
            <TableColumn fx:id="colunaStock" text="Stock real" minWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="1 caixa ="/>
        <TextField fx:id="campoUnidadesPorCaixa" promptText="ex.: 10" prefWidth="90"/>
        <Label text="unidades"/>
        <Button text="Guardar conversão" defaultButton="true" onAction="#onGuardar"/>
        <Button text="Fechar" cancelButton="true" onAction="#onFechar"/>
    </HBox>
    <Label fx:id="labelMensagem" wrapText="true"/>
</VBox>
