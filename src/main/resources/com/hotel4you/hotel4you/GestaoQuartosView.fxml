<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.GestaoQuartosViewController"
      spacing="12">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="8" prefWidth="330" minWidth="300">
        <Label text="Quartos (pisos 2 e 3)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <ListView fx:id="listaQuartos" VBox.vgrow="ALWAYS"/>
        <Button text="Voltar ao menu" onAction="#onVoltar"/>
    </VBox>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS">
        <VBox spacing="10">
            <padding>
                <Insets top="8" right="12" bottom="8" left="8"/>
            </padding>

            <Label fx:id="labelModo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Número do quarto" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNumero" promptText="ex.: 205" maxWidth="Infinity"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Localização" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoLocal" promptText="opcional" maxWidth="Infinity"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Tipo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="campoTipo" promptText="Individual, duplo ou família" maxWidth="Infinity"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Preço base por noite (€)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="campoPreco" promptText="ex.: 60,00" maxWidth="Infinity"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Vista" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="campoVista" maxWidth="Infinity"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Preço por noite" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label fx:id="labelPrecoNoite" style="-fx-font-weight: bold;"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                <Label text="Estado" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <CheckBox fx:id="campoAtivo" text="Quarto ativo (disponível para reservas)"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Equipamentos do quarto:"/>
            <VBox fx:id="caixaEquipamentos" spacing="4"/>
            <HBox spacing="8">
                <TextField fx:id="campoNovoEquipamento" promptText="Novo equipamento (ex.: Frigobar)"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Adicionar equipamento" onAction="#onAdicionarEquipamento"/>
            </HBox>

            <HBox spacing="8">
                <Button text="Novo quarto" onAction="#onNovo"/>
                <Button text="Guardar" defaultButton="true" onAction="#onGuardar"/>
            </HBox>
            <Label fx:id="labelMensagem" wrapText="true"/>
        </VBox>
    </ScrollPane>
</HBox>
