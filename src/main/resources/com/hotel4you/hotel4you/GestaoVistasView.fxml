<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.GestaoVistasViewController"
      spacing="14">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="8" prefWidth="380" minWidth="300" HBox.hgrow="ALWAYS">
        <Label text="Valores das vistas especiais" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <ListView fx:id="listaVistas" prefHeight="140" VBox.vgrow="ALWAYS"/>
        <Label fx:id="labelMensagem" wrapText="true"/>
        <Button text="Voltar ao menu" onAction="#onVoltar"/>
    </VBox>

    <VBox spacing="10" prefWidth="340" minWidth="300">
        <Label fx:id="labelModo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="95"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Valor (€) *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="campoValor" promptText="ex.: 20,00" maxWidth="Infinity"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        </GridPane>

        <Label text="Somado ao preço base por noite de todos os quartos com esta vista." wrapText="true"/>
        <Button text="Guardar" defaultButton="true" onAction="#onGuardar"/>
    </VBox>
</HBox>
