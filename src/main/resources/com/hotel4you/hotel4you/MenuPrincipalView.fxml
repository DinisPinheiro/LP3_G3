<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Layout principal: menu lateral fixo + área de conteúdo onde abrem os restantes ecrãs. -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel4you.hotel4you.View.MenuPrincipalViewController">

    <left>
        <VBox spacing="10" prefWidth="230" minWidth="230" maxWidth="230">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <VBox fx:id="caixaAreas" spacing="6">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8"/>
                    </padding>
                </VBox>
            </ScrollPane>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="labelUtilizador" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                       style="-fx-font-weight: bold;"/>
                <Button text="Terminar sessão" wrapText="true" onAction="#onTerminarSessao"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="0"/>
            </padding>

            <Label fx:id="labelTitulo" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox fx:id="caixaSeparadores" spacing="6"/>
            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                <StackPane fx:id="areaConteudo"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
