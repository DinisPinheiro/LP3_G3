<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel4you.hotel4you.View.GestaoReservasViewController"
            fitToWidth="true">
    <VBox spacing="8">
        <padding>
            <Insets top="14" right="18" bottom="14" left="18"/>
        </padding>

        <Label text="Criar reserva" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="1. Cliente" style="-fx-font-weight: bold;"/>
        <TextField fx:id="campoPesquisaCliente" promptText="Pesquisar por nome ou NIF/documento"/>
        <ListView fx:id="listaClientes" prefHeight="100"/>

        <Label text="2. Período e tipo de quarto" style="-fx-font-weight: bold;"/>
        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Data de entrada *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="campoEntrada" promptText="dd/mm/aaaa" maxWidth="Infinity"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Data de saída *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="campoSaida" promptText="dd/mm/aaaa" maxWidth="Infinity"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Tipo de quarto" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="campoTipo" promptText="Qualquer tipo" maxWidth="Infinity"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="8">
            <Button text="Ver quartos disponíveis" onAction="#onVerQuartos"/>
            <Button text="Limpar" onAction="#onLimpar"/>
            <Label text="Escreva 0 numa data e Enter para cancelar." style="-fx-text-fill: #777777;"/>
        </HBox>

        <Label text="3. Quartos disponíveis (escolha um)" style="-fx-font-weight: bold;"/>
        <ListView fx:id="listaQuartos" prefHeight="100"/>
        <Label fx:id="labelValor" style="-fx-font-weight: bold;" wrapText="true"/>

        <Button text="Criar reserva" defaultButton="true" onAction="#onCriar"/>
        <Label fx:id="labelMensagem" wrapText="true"/>

        <Label text="Reservas registadas:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="listaReservas" prefHeight="110"/>

        <Button text="Voltar ao menu" onAction="#onVoltar"/>
    </VBox>
</ScrollPane>