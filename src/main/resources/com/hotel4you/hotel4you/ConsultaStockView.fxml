<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ConsultaStockViewController"
      spacing="8">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Stock do hotel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="8">
        <Button text="Entrada de stock (XML do fornecedor)" onAction="#onEntradaXml"/>
        <Button text="Atualizar" onAction="#onAtualizar"/>
    </HBox>

    <Label fx:id="labelMensagem" wrapText="true"/>

    <TableView fx:id="tabelaStock" VBox.vgrow="ALWAYS" prefHeight="260">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaArtigo" text="Artigo" minWidth="220"/>
            <TableColumn fx:id="colunaQuantidade" text="Em stock" minWidth="70"/>
            <TableColumn fx:id="colunaUnidade" text="Unidade" minWidth="60"/>
            <TableColumn fx:id="colunaFornecedor" text="Fornecedor" minWidth="140"/>
        </columns>
    </TableView>

    <Button text="Voltar ao menu" onAction="#onVoltar"/>
</VBox>
