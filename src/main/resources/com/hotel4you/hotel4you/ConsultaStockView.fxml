<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ConsultaStockViewController"
      spacing="8">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Stock do hotel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Stock real: o total que o hotel tem. Em uso: o que está nas reservas com check-in. Disponível: o stock real menos o que está em uso. Os consumíveis saem do stock no check-out; os outros voltam."
           wrapText="true" style="-fx-text-fill: #555555;"/>

    <HBox spacing="8">
        <Button text="Atualizar" onAction="#onAtualizar"/>
        <Button text="Dar saída de stock" onAction="#onDarSaida"/>
        <Button text="Consumível sim/não" onAction="#onTrocarConsumivel"/>
        <Button text="Unidades dos produtos" onAction="#onUnidades"/>
    </HBox>

    <Label fx:id="labelMensagem" wrapText="true"/>

    <TableView fx:id="tabelaStock" VBox.vgrow="ALWAYS" prefHeight="220">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaArtigo" text="Artigo" minWidth="220"/>
            <TableColumn fx:id="colunaQuantidade" text="Stock real" minWidth="110"/>
            <TableColumn fx:id="colunaEmUso" text="Em uso" minWidth="60"/>
            <TableColumn fx:id="colunaDisponivel" text="Disponível" minWidth="70"/>
            <TableColumn fx:id="colunaConsumivel" text="Consumível" minWidth="75"/>
            <TableColumn fx:id="colunaUnidade" text="Unidade" minWidth="60"/>
            <TableColumn fx:id="colunaConversao" text="Conversão" minWidth="90"/>
            <TableColumn fx:id="colunaPreco" text="Preço unitário" minWidth="110"/>
            <TableColumn fx:id="colunaTaxa" text="Taxa" minWidth="50"/>
            <TableColumn fx:id="colunaFornecedor" text="Fornecedor" minWidth="140"/>
        </columns>
    </TableView>

    <Label text="Histórico de saídas" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="tabelaSaidas" VBox.vgrow="ALWAYS" prefHeight="160">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaSaidaData" text="Data/hora" minWidth="110"/>
            <TableColumn fx:id="colunaSaidaProduto" text="Produto" minWidth="180"/>
            <TableColumn fx:id="colunaSaidaTipo" text="Tipo" minWidth="70"/>
            <TableColumn fx:id="colunaSaidaQuantidade" text="Quantidade" minWidth="80"/>
            <TableColumn fx:id="colunaSaidaJustificacao" text="Justificação" minWidth="220"/>
            <TableColumn fx:id="colunaSaidaUtilizador" text="Utilizador" minWidth="120"/>
        </columns>
    </TableView>

    <Button text="Voltar ao menu" onAction="#onVoltar"/>
</VBox>
