<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ConsultaPassagensViewController"
      spacing="12">

    <padding>
        <Insets top="18" right="18"
                bottom="18" left="18"/>
    </padding>

    <Label text="Consulta de passagens"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Pesquisar por:"/>

        <ComboBox fx:id="tipoPesquisa"
                  prefWidth="130"/>

        <TextField fx:id="campoNumero"
                   promptText="Número do cartão ou do quarto"/>

        <ComboBox fx:id="campoLocal"
                  prefWidth="220"
                  visible="false"
                  managed="false"/>

        <Button text="Pesquisar"
                onAction="#pesquisar"/>

    </HBox>

    <ListView fx:id="listaPassagens"
              VBox.vgrow="ALWAYS"
              prefHeight="300"/>

    <Label fx:id="labelMensagem"
           wrapText="true"/>

    <Button text="Voltar"
            onAction="#voltar"/>

</VBox>