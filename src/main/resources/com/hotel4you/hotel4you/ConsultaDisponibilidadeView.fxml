<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel4you.hotel4you.View.ConsultaDisponibilidadeViewController"
      spacing="8">
    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <Label text="Consultar disponibilidade de quartos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Data de entrada *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoEntrada" promptText="dd/mm/aaaa" maxWidth="Infinity"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Data de saída *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoSaida" promptText="dd/mm/aaaa" maxWidth="Infinity"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Tipo de quarto" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="campoTipo" promptText="Qualquer tipo" maxWidth="Infinity"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="8">
        <Button text="Consultar" defaultButton="true" onAction="#onConsultar"/>
        <Button text="Limpar" onAction="#onLimpar"/>
        <Label text="Escolha as datas no calendário ou escreva-as como dd/mm/aaaa." style="-fx-text-fill: #777777;"/>
    </HBox>

    <Label fx:id="labelMensagem" wrapText="true"/>

    <TableView fx:id="tabelaQuartos" VBox.vgrow="ALWAYS" prefHeight="220">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colunaNumero" text="Quarto" minWidth="55"/>
            <TableColumn fx:id="colunaTipo" text="Tipo" minWidth="70"/>
            <TableColumn fx:id="colunaCapacidade" text="Hóspedes" minWidth="70"/>
            <TableColumn fx:id="colunaVista" text="Vista" minWidth="80"/>
            <TableColumn fx:id="colunaPreco" text="Preço/noite" minWidth="90"/>
            <TableColumn fx:id="colunaEquipamentos" text="Equipamentos" minWidth="150"/>
        </columns>
    </TableView>

    <Button text="Voltar ao menu" onAction="#onVoltar"/>
</VBox>
